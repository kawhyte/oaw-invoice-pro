# Template for .env.staging.local and .env.prod.local (used by package.json scripts).
# Real values: Supabase dashboard (Project Settings -> API), Resend dashboard, Vercel env vars.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Redirects ALL outgoing email to this address. Set in both local profiles (safety);
# the deployed app on Vercel uses its own env vars and sends real email.
RESEND_TO_OVERRIDE=
CRON_SECRET=
# File storage (S3-compatible). Backblaze B2 by default; Cloudflare R2 works by
# changing these values (R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto).
STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
STORAGE_REGION=us-east-005
STORAGE_BUCKET=ow-studio-staging-jm26
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
