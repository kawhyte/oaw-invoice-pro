# Template for .env.staging.local and .env.prod.local (used by package.json scripts).
# Never commit real values. Vercel holds the production copies (Settings → Environment Variables).

# Database: Neon Postgres, POOLED connection string of the branch
# (staging branch → .env.staging.local, production branch → .env.prod.local).
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Login (Better Auth). Secret: `openssl rand -base64 32`, different per environment.
BETTER_AUTH_SECRET=
# http://localhost:3000 locally; https://oaw-invoice-pro.vercel.app in Vercel production.
BETTER_AUTH_URL=http://localhost:3000

# File storage (S3-compatible). Backblaze B2 by default; Cloudflare R2 works by
# changing these values (R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto).
STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
STORAGE_REGION=us-east-005
STORAGE_BUCKET=ow-studio-staging-jm26
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Migration-only (old Supabase database, Session pooler URI). Remove once migrated.
# SUPABASE_DB_URL=
